# Backend — configuration de DÉVELOPPEMENT (versionnée, SANS secret réel).
# Les secrets réels (certificats SAML, etc.) vont dans .env.local (ignoré par git).

APP_NAME=BMCI-Gestion-Carrieres
ENV=development
LOG_LEVEL=INFO

# --- CORS (jamais "*" : wildcard interdit) ---
# :3001 = port du dev server Vite du frontend ; :3000/:5173 = ports historiques.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# --- IA locale (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=bge-m3
EMBED_DIM=1024
# Routage modèle-par-tâche : fichier à la racine du dépôt (ia/routing.yaml)
ROUTING_PATH=
AI_MAX_ATTEMPTS=2
AI_SEED=42

# --- Reranker (hors Ollama, via FlagEmbedding) ---
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_ENABLED=true

# --- Base de données ---
DATABASE_PATH=bmci_carrieres.db

# --- Référentiels de compétences (dossier à la racine : ia/referentiels/) ---
REFERENTIELS_DIR=

# --- Sessions / sécurité (repris de smart-objective) ---
SESSION_DURATION_HOURS=24
PBKDF2_ITERATIONS=200000
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
MAX_REQUEST_SIZE_MB=25

# --- Authentification / SSO ---
AUTH_PROVIDER=local
LOCAL_AUTH_ENABLED=auto
SAML_SIMULATION=false
SEED_DEMO_ACCOUNTS=true
SEED_SYNTHETIC_PERSONAS=true
# Population synthétique RH (~250 comptes complets répartis sur les départements) —
# alimente les insights data-driven (hauts potentiels, risque de départ, alertes, KPI).
SEED_POPULATION=true
